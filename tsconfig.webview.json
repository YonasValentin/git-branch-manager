{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "node",
		"target": "ES2020",
		"lib": ["ES2020", "DOM"],
		"jsx": "react-jsx",
		"sourceMap": true,
		"rootDir": "src/webview",
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"noUncheckedIndexedAccess": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src/webview/**/*"],
	"exclude": ["src/webview/**/*.unit.test.ts", "src/webview/**/*.unit.test.tsx", "src/webview/internals/testSetup.ts"]
}
